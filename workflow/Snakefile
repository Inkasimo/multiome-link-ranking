configfile: "config/default.yaml"

import os
import yaml


def clean_str(x):
    return str(x).strip()


def clean_path(*parts):
    return os.path.join(*(clean_str(p) for p in parts))


def assert_clean_path(name, path):
    path = clean_str(path)
    bad_parts = [p for p in path.split(os.sep) if p != p.strip()]
    if bad_parts:
        raise ValueError(f"{name} has whitespace-contaminated path components: " + repr(path))
    if path.endswith(" ") or path.startswith(" "):
        raise ValueError(f"{name} has leading/trailing whitespace: " + repr(path))
    return path


def read_yaml_if_exists(path):
    if os.path.exists(path):
        with open(path) as handle:
            return yaml.safe_load(handle) or {}
    return {}


DATASET = clean_str(config["dataset"])
OUTROOT = clean_str(config.get("output_root", "results"))
DATA_DIR = clean_str(config["data_dir"])

FEATURE_DIR = assert_clean_path("FEATURE_DIR", clean_path(OUTROOT, DATASET, "features"))
RANKING_DIR = assert_clean_path("RANKING_DIR", clean_path(OUTROOT, DATASET, "rankings"))

SCORE_MODES_FILE = assert_clean_path(
    "SCORE_MODES_FILE",
    clean_str(config.get("score_modes_file", config.get("ablations_file", "config/ablations.yaml")))
)

SCORE_MODES_CONFIG = read_yaml_if_exists(SCORE_MODES_FILE)

SCORE_MODES = SCORE_MODES_CONFIG.get(
    "score_modes",
    SCORE_MODES_CONFIG.get("ablations", {})
)

RANK_MODES = [clean_str(x) for x in SCORE_MODES.keys()]

# ============================================================
# SCENT producer config
# ============================================================
SCENT_RUN_CONFIG_FILE = assert_clean_path(
    "SCENT_RUN_CONFIG_FILE",
    clean_str(config.get("scent_run_config", "config/scent_run.yaml"))
)

SCENT_RUN_CONFIG_RAW = read_yaml_if_exists(SCENT_RUN_CONFIG_FILE)
SCENT_RUN_CONFIG = SCENT_RUN_CONFIG_RAW.get("scent_run", SCENT_RUN_CONFIG_RAW)

SCENT_RUN_OUTPUT_DIR = assert_clean_path(
    "SCENT_RUN_OUTPUT_DIR",
    clean_str(SCENT_RUN_CONFIG.get(
        "output_dir",
        clean_path(OUTROOT, DATASET, "scent_chr_sweep_100kb_frac020_1000cells")
    ))
)

SCENT_CHROMOSOMES_RAW = SCENT_RUN_CONFIG.get("chromosomes", ["chr1"])
if isinstance(SCENT_CHROMOSOMES_RAW, list):
    SCENT_CHROMOSOMES = ",".join(clean_str(x) for x in SCENT_CHROMOSOMES_RAW)
else:
    SCENT_CHROMOSOMES = clean_str(SCENT_CHROMOSOMES_RAW)

SCENT_LINK_DISTANCE = int(SCENT_RUN_CONFIG.get("link_distance", config.get("link_distance", 100000)))
SCENT_MIN_PAIR_FRAC = float(SCENT_RUN_CONFIG.get("min_pair_frac", 0.02))
SCENT_MAX_CELLS = int(SCENT_RUN_CONFIG.get("max_cells", 1000))
SCENT_MAX_CANDIDATES = int(SCENT_RUN_CONFIG.get("max_scent_candidates", 100000))
SCENT_CORES = int(SCENT_RUN_CONFIG.get("scent_cores", 4))
SCENT_REGR = clean_str(SCENT_RUN_CONFIG.get("scent_regr", "poisson"))
SCENT_SCORING_CELLTYPE = clean_str(SCENT_RUN_CONFIG.get("scoring_celltype", ""))
SCENT_SKIP_EXISTING = bool(SCENT_RUN_CONFIG.get("skip_existing", True))

scent_sweep_done = assert_clean_path("scent_sweep_done", clean_path(SCENT_RUN_OUTPUT_DIR, ".done"))

# ============================================================
# SCENT validation config
# ============================================================
SCENT_CONFIG_FILE = assert_clean_path(
    "SCENT_CONFIG_FILE",
    clean_str(config.get("scent_validation_config", "config/scent_validation.yaml"))
)

SCENT_CONFIG_RAW = read_yaml_if_exists(SCENT_CONFIG_FILE)
SCENT_CONFIG = SCENT_CONFIG_RAW.get("scent_validation", SCENT_CONFIG_RAW)

SCENT_METHODS = SCENT_CONFIG.get(
    "methods",
    ["linkpeaks", "coactivity", "coactivity_tf", "full_moddist_lambda_0_1", "distance_only"]
)
SCENT_METHODS = [clean_str(x) for x in SCENT_METHODS if clean_str(x)]

SCENT_SWEEP_DIR = assert_clean_path(
    "SCENT_SWEEP_DIR",
    clean_str(SCENT_CONFIG.get("scent_sweep_dir", SCENT_RUN_OUTPUT_DIR))
)

SCENT_OUTPUT_DIR = assert_clean_path(
    "SCENT_OUTPUT_DIR",
    clean_str(SCENT_CONFIG.get(
        "output_dir",
        clean_path(OUTROOT, DATASET, "scent_validation")
    ))
)

SCENT_TOP_N_VALUES = ",".join(clean_str(x) for x in SCENT_CONFIG.get("top_n_values", [50, 100, 200]))
SCENT_TOP_K_COMPARE = int(SCENT_CONFIG.get("top_k_compare", 200))
SCENT_RECIPROCAL_OVERLAP = float(SCENT_CONFIG.get("reciprocal_overlap", 0.50))
SCENT_SUPPORT_RULE = clean_str(SCENT_CONFIG.get("scent_support_rule", "pvalue_positive"))
SCENT_P_THRESHOLD = float(SCENT_CONFIG.get("scent_p_threshold", 0.05))
SCENT_MIN_SCORE = float(SCENT_CONFIG.get("scent_min_score", 0.0))
SCENT_DISTAL_THRESHOLD = int(SCENT_CONFIG.get("distal_threshold", config.get("distal_threshold", 50000)))
SCENT_DISTANCE_D0 = float(SCENT_CONFIG.get("distance_d0", config.get("distance_d0", 50000)))
SCENT_RESTRICT_TO_CHRS = bool(SCENT_CONFIG.get("restrict_to_scent_chrs", True))
SCENT_WRITE_STANDARDIZED_LINKS = bool(SCENT_CONFIG.get("write_standardized_links", False))

# ============================================================
# Canonical paths
# ============================================================
feature_csv = assert_clean_path("feature_csv", clean_path(FEATURE_DIR, DATASET + "_link_features.csv"))
baseline_csv = assert_clean_path("baseline_csv", clean_path(FEATURE_DIR, DATASET + "_baseline_links_full.csv"))
baseline_dist_csv = assert_clean_path("baseline_dist_csv", clean_path(FEATURE_DIR, DATASET + "_baseline_links_with_distance.csv"))
features_done = assert_clean_path("features_done", clean_path(FEATURE_DIR, ".done"))

ranking_done = assert_clean_path("ranking_done", clean_path(RANKING_DIR, "{rank_mode}", ".done"))
ranking_csv = assert_clean_path("ranking_csv", clean_path(RANKING_DIR, "{rank_mode}", DATASET + "_{rank_mode}_ranked_links.csv"))
scent_done = assert_clean_path("scent_done", clean_path(SCENT_OUTPUT_DIR, ".done"))

# Fail early if SCENT config references modes not present in the scoring config.
missing_scent_modes = sorted(set(SCENT_METHODS) - set(RANK_MODES))
if missing_scent_modes:
    raise ValueError(
        "SCENT methods are missing from config/ablations.yaml: " + ", ".join(missing_scent_modes)
    )


rule all:
    input:
        features_done,
        expand(ranking_done, rank_mode=RANK_MODES)


rule all_with_scent:
    input:
        features_done,
        expand(ranking_done, rank_mode=RANK_MODES),
        scent_done


rule linkpeaks_reranker_features:
    input:
        h5=lambda wc: clean_path(DATA_DIR, config["h5_file"]),
        fragments=lambda wc: clean_path(DATA_DIR, config["frag_file"]),
        fragments_index=lambda wc: clean_path(DATA_DIR, clean_str(config["frag_file"]) + ".tbi")
    output:
        features=feature_csv,
        baseline=baseline_csv,
        baseline_dist=baseline_dist_csv,
        done=features_done
    params:
        output_dir=FEATURE_DIR,
        run_name=DATASET,
        checkpoint_flag=lambda wc: "--save-checkpoints" if config.get("save_checkpoints", False) else ""
    shell:
        r"""
        Rscript scripts/run_linkpeaks_reranker.R \
          --data-dir {DATA_DIR} \
          --h5-file {config[h5_file]} \
          --frag-file {config[frag_file]} \
          --candidate-top-k {config[candidate_top_k]} \
          --link-distance {config[link_distance]} \
          --distance-d0 {config[distance_d0]} \
          --cluster-resolution {config[cluster_resolution]} \
          --pca-dims {config[pca_dims]} \
          --lsi-dims-start {config[lsi_dims_start]} \
          --lsi-dims-end {config[lsi_dims_end]} \
          --species {config[species]} \
          --collection {config[collection]} \
          --tf-expressed-frac {config[tf_expressed_frac]} \
          --top-k-motif-names {config[top_k_motif_names]} \
          --output-dir {params.output_dir} \
          --run-name {params.run_name} \
          --seed {config[seed]} \
          {params.checkpoint_flag} \
          --done-file {output.done}
        """


rule evaluate_ranking:
    input:
        features=feature_csv,
        baseline=baseline_csv,
        baseline_dist=baseline_dist_csv,
        features_done=features_done
    output:
        ranked=ranking_csv,
        done=ranking_done
    params:
        outdir=lambda wc: clean_path(RANKING_DIR, wc.rank_mode),
        run_name=lambda wc: DATASET + "_" + wc.rank_mode,
        score_mode=lambda wc: SCORE_MODES[wc.rank_mode].get("score_mode", wc.rank_mode),
        lambda_distance=lambda wc: SCORE_MODES[wc.rank_mode].get("lambda_distance", config["lambda_distance"]),
        alpha_tf=lambda wc: SCORE_MODES[wc.rank_mode].get("alpha_tf", config["alpha_tf"])
    shell:
        r"""
        Rscript scripts/evaluate_rankings.R \
          --features-file {input.features} \
          --baseline-file {input.baseline} \
          --baseline-distance-file {input.baseline_dist} \
          --score-mode {params.score_mode} \
          --lambda-distance {params.lambda_distance} \
          --alpha-tf {params.alpha_tf} \
          --ora-top-n {config[ora_top_n]} \
          --ora-show-category {config[ora_show_category]} \
          --tier-high-quantile {config[tier_high_quantile]} \
          --tier-medium-quantile {config[tier_medium_quantile]} \
          --output-dir {params.outdir} \
          --run-name {params.run_name} \
          --done-file {output.done}
        """


rule scent_chr_sweep:
    input:
        h5=lambda wc: clean_path(DATA_DIR, config["h5_file"])
    output:
        done=scent_sweep_done
    params:
        output_dir=SCENT_RUN_OUTPUT_DIR,
        chromosomes=SCENT_CHROMOSOMES,
        link_distance=SCENT_LINK_DISTANCE,
        min_pair_frac=SCENT_MIN_PAIR_FRAC,
        max_cells=SCENT_MAX_CELLS,
        max_scent_candidates=SCENT_MAX_CANDIDATES,
        scent_cores=SCENT_CORES,
        scent_regr=SCENT_REGR,
        scoring_celltype_flag=("--scoring-celltype " + SCENT_SCORING_CELLTYPE) if SCENT_SCORING_CELLTYPE else "",
        skip_existing_flag="--skip-existing" if SCENT_SKIP_EXISTING else "--no-skip-existing"
    shell:
        r"""
        Rscript scripts/run_scent_chr_sweep.R \
          --data-dir {DATA_DIR} \
          --h5-file {config[h5_file]} \
          --output-dir {params.output_dir} \
          --chromosomes {params.chromosomes} \
          --link-distance {params.link_distance} \
          --min-pair-frac {params.min_pair_frac} \
          --max-cells {params.max_cells} \
          --max-scent-candidates {params.max_scent_candidates} \
          --scent-cores {params.scent_cores} \
          --scent-regr {params.scent_regr} \
          {params.scoring_celltype_flag} \
          {params.skip_existing_flag} \
          --seed {config[seed]} \
          --done-file {output.done}
        """


rule scent_validation:
    input:
        scent_sweep_done=scent_sweep_done,
        rankings_done=expand(ranking_done, rank_mode=SCENT_METHODS),
        ranked_files=expand(ranking_csv, rank_mode=SCENT_METHODS)
    output:
        done=scent_done
    params:
        rankings_dir=RANKING_DIR,
        scent_sweep_dir=SCENT_SWEEP_DIR,
        output_dir=SCENT_OUTPUT_DIR,
        methods=",".join(SCENT_METHODS),
        top_n_values=SCENT_TOP_N_VALUES,
        top_k_compare=SCENT_TOP_K_COMPARE,
        reciprocal_overlap=SCENT_RECIPROCAL_OVERLAP,
        scent_support_rule=SCENT_SUPPORT_RULE,
        scent_p_threshold=SCENT_P_THRESHOLD,
        scent_min_score=SCENT_MIN_SCORE,
        distance_d0=SCENT_DISTANCE_D0,
        distal_threshold=SCENT_DISTAL_THRESHOLD,
        restrict_flag="--restrict-to-scent-chrs" if SCENT_RESTRICT_TO_CHRS else "--no-restrict-to-scent-chrs",
        write_links_flag="--write-standardized-links" if SCENT_WRITE_STANDARDIZED_LINKS else ""
    shell:
        r"""
        Rscript scripts/benchmark_scent_validation.R \
          --dataset {DATASET} \
          --rankings-dir {params.rankings_dir} \
          --scent-sweep-dir {params.scent_sweep_dir} \
          --output-dir {params.output_dir} \
          --methods {params.methods} \
          --top-n-values {params.top_n_values} \
          --top-k-compare {params.top_k_compare} \
          --reciprocal-overlap {params.reciprocal_overlap} \
          --scent-support-rule {params.scent_support_rule} \
          --scent-p-threshold {params.scent_p_threshold} \
          --scent-min-score {params.scent_min_score} \
          --distance-d0 {params.distance_d0} \
          --distal-threshold {params.distal_threshold} \
          {params.restrict_flag} \
          {params.write_links_flag} \
          --seed {config[seed]} \
          --done-file {output.done}
        """


# Proximal-removal SCENT validation summary.
# Light post-processing only; does not rerun SCENT.
configfile: "config/scent_validation_min_distance.yaml"

rule scent_validation_min_distance:
    input:
        validation_done=clean_path(OUTROOT, DATASET, "scent_validation", ".done"),
        combined=clean_path(OUTROOT, DATASET, "scent_validation", "scent_validation_all_ranked_methods_combined.csv")
    output:
        done=touch(clean_path(OUTROOT, DATASET, "scent_validation_min_distance", ".done"))
    params:
        output_dir=clean_path(OUTROOT, DATASET, "scent_validation_min_distance"),
        min_distances=lambda wildcards: config["min_distances"],
        top_n_values=lambda wildcards: config["top_n_values"],
        high_fraction=lambda wildcards: config["high_fraction"]
    shell:
        "mkdir -p {params.output_dir} && "
        "Rscript scripts/summarize_scent_validation_min_distance.R "
        "--input {input.combined} "
        "--output-dir {params.output_dir} "
        "--min-distances {params.min_distances} "
        "--top-n-values {params.top_n_values} "
        "--high-fraction {params.high_fraction}"

